<article class="feed {{post_class}}" data-month="{{date format="MMMM YYYY"}}">

    <div class="feed-calendar">
        <div class="feed-calendar-day">
            {{date published_at format="DD"}}
        </div>
        <div class="feed-calendar-month">
            {{date published_at format="MMM"}}
        </div>
    </div>

    {{#match @custom.feed_layout "!=" "Text-only"}}
    {{#match @custom.feed_layout "!=" "Minimal"}}
        <div class="feed-image u-placeholder rectangle">
            {{#if feature_image}}
                <img
                    class="u-object-fit"
                    srcset="{{> "srcset"}}"
                    sizes="(min-width: 576px) 160px, 90vw"
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    {{!-- Only the first card of a listing page is above the fold. On
                    posts/pages this partial renders the related posts at the bottom, and
                    on the homepage the full-screen cover or the featured posts push the
                    feed down when they're shown. --}}
                    {{#if @first}}
                        {{#is "post, page"}}
                            loading="lazy"
                        {{else is "home"}}
                            {{#if @site.cover_image}}loading="lazy"{{else if @custom.show_featured_posts}}loading="lazy"{{else}}fetchpriority="high"{{/if}}
                        {{else}}
                            fetchpriority="high"
                        {{/is}}
                    {{else}}
                        loading="lazy"
                    {{/if}}
                >
            {{/if}}
        </div>
    {{/match}}
    {{/match}}

    <div class="feed-wrapper">
        <h2 class="feed-title">{{title}}</h2>
        {{#if excerpt}}
            <div class="feed-excerpt">{{excerpt words="20"}}</div>
        {{/if}}
        <div class="feed-right">
            <time class="feed-date" datetime="{{date format="YYYY-MM-DD"}}">
                {{date published_at format="DD MMM YYYY"}}
            </time>
            <div class="feed-visibility feed-visibility-{{visibility}}">
                {{> "icons/star"}}
            </div>
            {{#if reading_time}}
                <div class="feed-length">
                    {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}
                </div>
            {{/if}}
            {{#has tag="#external-link"}}{{> "feed-external"}}{{/has}}
            {{#if @site.comments_enabled}}
                {{comment_count autowrap="div" class="feed-comments"}}
            {{/if}}
            <div class="feed-icon">
                {{> "icons/chevron-right"}}
            </div>
        </div>
    </div>

    {{#has tag="#external-link"}}
        <a class="u-permalink" href="{{canonical_url}}" aria-label="{{title}}" target="_blank" rel="noopener noreferrer"></a>
    {{else}}
        <a class="u-permalink" href="{{url}}" aria-label="{{title}}"></a>
    {{/has}}

</article>